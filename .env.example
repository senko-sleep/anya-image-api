# Anya Image API Environment Variables

# Server Port (Render sets this automatically)
PORT=10000

# Node Environment
NODE_ENV=production

# Cloudflare Images API (optional - for image caching/CDN)
# Get these from Cloudflare Dashboard > Images
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
# Optional: Custom delivery URL (defaults to imagedelivery.net)
# CLOUDFLARE_IMAGES_URL=https://imagedelivery.net/your_account_id

# Optional: Rate limit overrides (requests per second)
# SAFEBOORU_RATE_LIMIT=2
# DANBOORU_RATE_LIMIT=1
# GELBOORU_RATE_LIMIT=2
# YANDERE_RATE_LIMIT=3
# KONACHAN_RATE_LIMIT=3
# TBIB_RATE_LIMIT=2

# Optional: Cache TTL (milliseconds)
# IMAGE_CACHE_TTL=7200000  # 2 hours
# TAG_CACHE_TTL=86400000   # 24 hours
